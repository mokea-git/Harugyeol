PORT=3000

# SQLite (Primary DB)
SQLITE_PATH=./data/harugyeol.sqlite

# PostgreSQL (Backup DB — 설정하면 자동으로 이중 백업 활성화)
# POSTGRES_URL=postgresql://user:password@host:5432/harugyeol

# Supabase OAuth/Auth only (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...           # OAuth 토큰 검증용
# SUPABASE_SERVICE_ROLE_KEY=eyJ... # 필요 시 대체 가능

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend (이메일)
RESEND_API_KEY=re_...
RESEND_FROM=support@mokea.cloud